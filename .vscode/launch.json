{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug API",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/api",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "ENV": "dev",
        "PORT": "8080",
        "APP_VERSION": "1.0.0",
        "OTEL_SERVICE_NAME": "loopi-api",
        "OTEL_EXPORTER_OTLP_ENDPOINT": ""
      }
    },
    {
      "name": "Run API",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/api",
      "noDebug": true,
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "ENV": "dev",
        "PORT": "8080",
        "APP_VERSION": "1.0.0",
        "OTEL_SERVICE_NAME": "loopi-api",
        "OTEL_EXPORTER_OTLP_ENDPOINT": ""
      }
    }
  ]
}
